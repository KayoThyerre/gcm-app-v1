# Runtime
NODE_ENV=development
PORT=3333

# Required in production. Use the exact frontend origin.
CORS_ORIGIN=http://localhost:5173

# Public backend URL used to build auth verification links.
# Required in production.
API_PUBLIC_URL=http://localhost:3333

# Database - required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Auth - required. Use a long random value in real environments.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# E-mail verification.
# Default "console" keeps local/dev flow working without sending real e-mails.
# Use "resend" with EMAIL_FROM and EMAIL_API_KEY to send real transactional e-mails.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# EMAIL_FROM="GCM <no-reply@your-domain.com>"
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional local debug. Never enable in shared logs.
EMAIL_LOG_VERIFICATION_LINKS=false

# Optional one-off bootstrap script inputs.
# Use only for controlled initial deploy/admin recovery flows.
# BOOTSTRAP_DEV_EMAIL=dev@example.com
# BOOTSTRAP_DEV_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# BOOTSTRAP_DEV_NAME=Initial DEV
