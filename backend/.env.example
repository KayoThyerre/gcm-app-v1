# Runtime
NODE_ENV=development
PORT=3333

# Required in production. Use the exact frontend origin.
CORS_ORIGIN=http://localhost:5173

# Public backend URL used to build auth verification links.
# Required in production.
API_PUBLIC_URL=http://localhost:3333

# Database - required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Auth - required. Use a long random value in real environments.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional one-off bootstrap script inputs.
# Use only for controlled initial deploy/admin recovery flows.
# BOOTSTRAP_DEV_EMAIL=dev@example.com
# BOOTSTRAP_DEV_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# BOOTSTRAP_DEV_NAME=Initial DEV
